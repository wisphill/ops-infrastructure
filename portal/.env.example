# OAuth 2.0 Client ID (type "Web application") from Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx

# Key for signing session cookies, min 32 chars. Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-change-me-change-me-change-me

# Public URL of the portal; {BASE_URL}/auth/callback must be an authorized redirect URI on the OAuth client.
# Cookies get the Secure flag automatically when this starts with https://
BASE_URL=http://localhost:8080
LISTEN_ADDR=:8080
WEB_DIR=../web
